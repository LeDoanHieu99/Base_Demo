class Algo:
    def __init__(self, fx, fy):
        self.fx = fx
        self.fy = fy
        assert len(fy) > 0
        for poly in fy:
            assert poly > 0
            assert poly < (1 << fx)
        self.outputs = []
        self.initialize_outputs()

    def initialize_outputs(self):
        self.outputs = [''] * (1 << self.fx)
        for i in range(len(self.outputs)):
            for j in range(len(self.fy)):
                polynomial = self.reverse_bits(self.fx, self.fy[j])
                input_val = i
                output = 0
                for k in range(self.fx):
                    output ^= (input_val & 1) & (polynomial & 1)
                    polynomial >>= 1
                    input_val >>= 1
                self.outputs[i] += '1' if output else '0'

    def reverse_bits(self, num_bits, input_val):
        output = 0
        while num_bits > 0:
            output = (output << 1) + (input_val & 1)
            input_val >>= 1
            num_bits -= 1
        return output

    def next_state(self, current_state, input_val):
        return ((current_state >> 1) | (input_val << (self.fx - 2)))

    def output(self, current_state, input_val):
        return self.outputs[current_state | (input_val << (self.fx - 1))]

    def encode(self, bits):
        encoded = ''
        state = 0

        for i in range(len(bits)):
            input_val = int(bits[i])
            encoded += self.output(state, input_val)
            state = self.next_state(state, input_val)

        for i in range(self.fx - 1):
            encoded += self.output(state, 0)
            state = self.next_state(state, 0)

        return encoded

