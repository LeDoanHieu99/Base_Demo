def pad(text, block_size):
    padding = block_size - len(text) % block_size
    return text + bytes([padding] * padding)

def unpad(text):
    padding = text[-1]
    return text[:-padding]

def xor_bytes(a, b):
    return bytes(x ^ y for x, y in zip(a, b))

def encrypt_block_cbc(block, key):
    block = xor_bytes(block, key)
    cipher = AES.new(key, AES.MODE_ECB)
    return cipher.encrypt(block)


def encrypt_cbc(plaintext, key):
    block_size = len(key)
    padded_text = pad(plaintext, block_size)
    encrypted_text = b''
    previous_block = key

    for i in range(0, len(padded_text), block_size):
        block = padded_text[i:i+block_size]
        encrypted_block = encrypt_block_cbc(block, key)
        encrypted_text += encrypted_block
        previous_block = encrypted_block

    return encrypted_text


